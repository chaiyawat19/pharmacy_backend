# ==============================
# PostgreSQL Database
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=pharmacy_project

# ==============================
# JWT
# ==============================
# สร้างด้วย: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here

# ==============================
# App Port
# ==============================
PORT=5000

# ==============================
# Frontend URL (ใช้ใน Google OAuth callback redirect และลิงก์ในอีเมล)
# ==============================
FRONTEND_URL=http://localhost:3000

# ==============================
# Backend URL (ใช้ใน Google OAuth callbackURL และ URL รูปภาพข่าวสาร)
# ==============================
BACKEND_URL=http://localhost:5000

# ==============================
# Node.js DNS Fix (Windows)
# ==============================
NODE_OPTIONS=--dns-result-order=ipv4first

# ==============================
# Google OAuth
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================
# Mail (Gmail SMTP — ใช้ส่ง OTP, ยืนยันการชำระเงิน, เตือนหมดอายุ)
# ==============================
# MAIL_PASS ต้องเป็น App Password ไม่ใช่รหัสผ่านบัญชี Google
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# ==============================
# Pinecone (Vector Database — ใช้กับแชตบอต)
# ==============================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name

# ==============================
# Gemini AI
# ==============================
GEMINI_API_KEY=your_gemini_api_key

# ==============================
# ระบบชำระเงิน (สิทธิ์ Admin รายปี)
# ==============================
# บัญชีรับเงินพร้อมเพย์ — เบอร์โทร 10 หลัก หรือเลขบัตรประชาชน 13 หลัก
PROMPTPAY_ID=0812345678

# ราคาเริ่มต้นตอนสร้างแถวตั้งค่าครั้งแรก (บาท/ปี) — ไม่ตั้ง = 2720 ซึ่งเป็นราคาจริง
# ตั้งเป็นเลขน้อย ๆ เช่น 20 ตอนทดสอบการโอนจริง แก้ราคาถาวรได้จากหน้า Super Admin
PAYMENT_DEFAULT_ANNUAL_PRICE=2720

# เบอร์ TrueMoney Wallet สำหรับรับโอน (ไม่ตั้งค่า = ปิดช่องทางนี้)
TRUEWALLET_PHONE=0812345678

# Thunder API — ใช้ตรวจสอบสลิปโอนเงิน (สมัครที่ https://thunder.in.th)
# ไม่ตั้งค่า THUNDER_API_KEY = ยืนยันสลิปไม่ได้เลย
THUNDER_API_KEY=your_thunder_api_key
THUNDER_API_URL=https://api.thunder.in.th/v2
